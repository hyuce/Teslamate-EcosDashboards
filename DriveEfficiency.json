          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT ROUND((SUM((d.start_rated_range_km - d.end_rated_range_km) * cars.efficiency) * 1000.0 / NULLIF(SUM(d.distance), 0))::numeric, 0) AS \"Consumption [Wh/km]\" FROM drives d CROSS JOIN cars WHERE d.car_id = $car_id AND cars.id = $car_id AND d.distance > 1 AND (d.start_rated_range_km - d.end_rated_range_km) > 0 AND $__timeFilter(d.start_date)",
