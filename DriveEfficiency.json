          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN d.speed_max < 40 THEN '0-40' WHEN d.speed_max < 80 THEN '40-80' WHEN d.speed_max < 120 THEN '80-120' ELSE '120+' END AS \"Speed [km/h]\", ROUND(AVG((d.start_rated_range_km - d.end_rated_range_km) * cars.efficiency * 1000.0 / NULLIF(d.distance, 0))::numeric, 0) AS \"Consumption [Wh/km]\" FROM drives d CROSS JOIN cars WHERE d.car_id = $car_id AND cars.id = $car_id AND d.distance > 1 AND (d.start_rated_range_km - d.end_rated_range_km) > 0 AND $__timeFilter(d.start_date) GROUP BY 1 ORDER BY MIN(d.speed_max)",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Consumption by Speed",
      "type": "barchart",
      "description": "Average consumption (Wh/km) by peak speed."
