          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN d.outside_temp_avg < 0 THEN '<0°C' WHEN d.outside_temp_avg < 5 THEN '0-5°C' WHEN d.outside_temp_avg < 10 THEN '5-10°C' WHEN d.outside_temp_avg < 15 THEN '10-15°C' WHEN d.outside_temp_avg < 20 THEN '15-20°C' WHEN d.outside_temp_avg < 25 THEN '20-25°C' WHEN d.outside_temp_avg < 30 THEN '25-30°C' ELSE '30°C+' END AS \"Temperature\", ROUND(AVG((d.start_rated_range_km - d.end_rated_range_km) * cars.efficiency * 1000.0 / NULLIF(d.distance, 0))::numeric, 0) AS \"Consumption [Wh/km]\" FROM drives d CROSS JOIN cars WHERE d.car_id = $car_id AND cars.id = $car_id AND d.distance > 1 AND (d.start_rated_range_km - d.end_rated_range_km) > 0 AND d.outside_temp_avg IS NOT NULL AND $__timeFilter(d.start_date) GROUP BY 1 ORDER BY MIN(d.outside_temp_avg)",
